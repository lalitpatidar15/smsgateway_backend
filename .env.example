DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_gateway?schema=public"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

APP_PORT="3000"
APP_ENV="development"

ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="admin123"

GATEWAY_TOKEN_PREFIX="gw_"
API_KEY_PREFIX="sg_live_"

HEARTBEAT_ONLINE_THRESHOLD_MS="60000"
HEARTBEAT_DEGRADED_THRESHOLD_MS="300000"

CLAIM_EXPIRY_MINUTES="2"

SMS_MAX_ATTEMPTS="3"
SMS_RETRY_DELAYS_MS="30000,120000,600000"

RATE_LIMIT_SMS_PER_MINUTE="100"
RATE_LIMIT_RECIPIENT_PER_HOUR="5"
RATE_LIMIT_GATEWAY_PER_MINUTE="20"

DAILY_SMS_LIMIT_PER_API_KEY="500"
DAILY_SMS_LIMIT_PER_GATEWAY="2000"

BULK_SMS_MAX_MESSAGES="100"

WEBHOOK_MAX_ATTEMPTS="5"
WEBHOOK_RETRY_DELAYS_MS="60000,300000,1800000,7200000"

CORS_ORIGINS="http://localhost:3000"
