generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      AdminRole @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model ApiKey {
  id                 String      @id @default(uuid())
  name               String
  keyHash            String      @unique @map("key_hash")
  keyPrefix          String      @map("key_prefix")
  status             ApiKeyStatus @default(ACTIVE)
  permissions        String[]
  rateLimitPerMinute Int         @default(100) @map("rate_limit_per_minute")
  dailyLimit         Int         @default(500) @map("daily_limit")
  createdAt          DateTime    @default(now()) @map("created_at")
  lastUsedAt         DateTime?   @map("last_used_at")
  revokedAt          DateTime?   @map("revoked_at")

  smsJobs SmsJob[]

  @@map("api_keys")
}

enum GatewayStatus {
  PENDING
  ACTIVE
  OFFLINE
  DEGRADED
  DISABLED
  BLOCKED
}

model GatewayDevice {
  id            String        @id @default(uuid())
  name          String
  deviceId      String        @unique @map("device_id")
  phoneNumber   String?       @map("phone_number")
  tokenHash     String        @unique @map("token_hash")
  platform      String        @default("android")
  appVersion    String?       @map("app_version")
  manufacturer  String?
  model         String?
  androidVersion String?      @map("android_version")
  status        GatewayStatus @default(PENDING)
  lastSeenAt    DateTime?     @map("last_seen_at")
  lastIp        String?       @map("last_ip")
  battery       Int?
  charging      Boolean?
  network       String?
  signalStrength Int?         @map("signal_strength")
  simCount      Int?          @map("sim_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sims       GatewaySim[]
  smsJobs    SmsJob[]
  smsAttempts SmsAttempt[]
  webhookEndpoints WebhookEndpoint[]

  @@map("gateway_devices")
}

model GatewaySim {
  id               String   @id @default(uuid())
  gatewayDeviceId  String   @map("gateway_device_id")
  slotIndex        Int      @map("slot_index")
  subscriptionId   String?  @map("subscription_id")
  carrierName      String?  @map("carrier_name")
  phoneNumber      String   @map("phone_number")
  countryCode      String?  @map("country_code")
  isActive         Boolean  @default(true) @map("is_active")
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  gatewayDevice GatewayDevice @relation(fields: [gatewayDeviceId], references: [id], onDelete: Cascade)
  smsJobs       SmsJob[]
  smsAttempts   SmsAttempt[]

  @@unique([gatewayDeviceId, slotIndex])
  @@map("gateway_sims")
}

enum SmsJobStatus {
  QUEUED
  SCHEDULED
  CLAIMED
  SENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
  EXPIRED
  CANCELLED
}

enum SmsPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SmsJob {
  id                String      @id @default(uuid())
  externalId        String?     @unique @map("external_id")
  apiKeyId          String?     @map("api_key_id")
  idempotencyKey    String?     @unique @map("idempotency_key")
  recipient         String
  message           String
  status            SmsJobStatus @default(QUEUED)
  priority          SmsPriority @default(NORMAL)
  gatewayDeviceId   String?     @map("gateway_device_id")
  gatewaySimId      String?     @map("gateway_sim_id")
  attemptCount      Int         @default(0) @map("attempt_count")
  maxAttempts       Int         @default(3) @map("max_attempts")
  scheduledAt       DateTime?   @map("scheduled_at")
  claimedAt         DateTime?   @map("claimed_at")
  claimExpiresAt    DateTime?   @map("claim_expires_at")
  sentAt            DateTime?   @map("sent_at")
  deliveredAt       DateTime?   @map("delivered_at")
  failedAt          DateTime?   @map("failed_at")
  providerReference String?     @map("provider_reference")
  lastErrorCode     String?     @map("last_error_code")
  lastErrorMessage  String?     @map("last_error_message")
  segmentCount      Int         @default(1) @map("segment_count")
  encoding          String      @default("GSM-7")
  metadata          Json?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  apiKey          ApiKey?          @relation(fields: [apiKeyId], references: [id])
  gatewayDevice   GatewayDevice?   @relation(fields: [gatewayDeviceId], references: [id])
  gatewaySim      GatewaySim?      @relation(fields: [gatewaySimId], references: [id])
  attempts        SmsAttempt[]
  webhookDeliveries WebhookDelivery[]

  @@index([status, scheduledAt])
  @@index([gatewayDeviceId, status])
  @@index([recipient])
  @@index([createdAt])
  @@map("sms_jobs")
}

model SmsAttempt {
  id               String    @id @default(uuid())
  smsJobId         String    @map("sms_job_id")
  gatewayDeviceId  String    @map("gateway_device_id")
  gatewaySimId     String?   @map("gateway_sim_id")
  attemptNumber    Int       @map("attempt_number")
  status           String
  errorCode        String?   @map("error_code")
  errorMessage     String?   @map("error_message")
  startedAt        DateTime  @default(now()) @map("started_at")
  sentAt           DateTime? @map("sent_at")
  completedAt      DateTime? @map("completed_at")

  smsJob        SmsJob        @relation(fields: [smsJobId], references: [id], onDelete: Cascade)
  gatewayDevice GatewayDevice @relation(fields: [gatewayDeviceId], references: [id])
  gatewaySim    GatewaySim?   @relation(fields: [gatewaySimId], references: [id])

  @@map("sms_attempts")
}

model WebhookEndpoint {
  id              String   @id @default(uuid())
  gatewayDeviceId String?  @map("gateway_device_id")
  url             String
  secret          String
  events          String[]
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  gatewayDevice GatewayDevice?    @relation(fields: [gatewayDeviceId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model WebhookDelivery {
  id                 String               @id @default(uuid())
  webhookEndpointId  String               @map("webhook_endpoint_id")
  smsJobId           String?              @map("sms_job_id")
  event              String
  payload            Json
  status             WebhookDeliveryStatus @default(PENDING)
  statusCode         Int?                 @map("status_code")
  response           String?
  attemptCount       Int                  @default(0) @map("attempt_count")
  maxAttempts        Int                  @default(5) @map("max_attempts")
  nextRetryAt        DateTime?            @map("next_retry_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  smsJob          SmsJob?         @relation(fields: [smsJobId], references: [id])

  @@map("webhook_deliveries")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorType    String   @map("actor_type")
  actorId      String?  @map("actor_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ip           String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}
