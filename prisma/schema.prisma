generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum UserRole {
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum GatewayStatus {
  PENDING
  ACTIVE
  OFFLINE
  DEGRADED
  DISABLED
  BLOCKED
}

enum SmsJobStatus {
  QUEUED
  SCHEDULED
  CLAIMED
  SENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
  EXPIRED
  CANCELLED
}

enum SmsPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model AdminUser {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  role      AdminRole @default(ADMIN)
  isActive  Boolean   @default(true) @map("isActive")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organizationMembers OrganizationMember[]

  @@map("admin_users")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  name           String?
  role           UserRole  @default(MEMBER)
  isActive       Boolean   @default(true) @map("isActive")
  organizationId String    @map("organization_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys        ApiKey[]
  smsJobs        SmsJob[]
  otpSessions    OtpSession[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  adminUsers OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  adminUserId     String   @map("admin_user_id")
  role            String   @default("ADMIN")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admin        AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, adminUserId])
  @@map("organization_members")
}

model ApiKey {
  id                String       @id @default(uuid())
  name              String
  keyHash           String       @unique @map("key_hash")
  keyPrefix         String       @map("key_prefix")
  status            ApiKeyStatus @default(ACTIVE)
  permissions       String[]     @default([])
  rateLimitPerMinute Int         @default(100) @map("rate_limit_per_minute")
  dailyLimit        Int          @default(500) @map("daily_limit")
  createdAt         DateTime     @default(now()) @map("created_at")
  lastUsedAt        DateTime?    @map("last_used_at")
  revokedAt         DateTime?    @map("revoked_at")
  userId            String?      @map("user_id")

  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  smsJobs           SmsJob[]

  @@map("api_keys")
}

model GatewayDevice {
  id            String        @id @default(uuid())
  name          String
  deviceId      String        @unique @map("device_id")
  phoneNumber   String?       @map("phone_number")
  tokenHash     String        @unique @map("token_hash")
  platform      String        @default("android")
  appVersion    String?       @map("app_version")
  manufacturer  String?
  model         String?
  androidVersion String?      @map("android_version")
  status        GatewayStatus @default(PENDING)
  lastSeenAt    DateTime?     @map("last_seen_at")
  lastIp        String?       @map("last_ip")
  battery       Int?
  charging      Boolean?
  network       String?
  signalStrength Int?         @map("signal_strength")
  simCount      Int?          @map("sim_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sims            GatewaySim[]
  smsJobs         SmsJob[]
  smsAttempts     SmsAttempt[]
  webhookEndpoints WebhookEndpoint[]
  inboundSms      InboundSms[]

  @@map("gateway_devices")
}

model GatewaySim {
  id             String        @id @default(uuid())
  gatewayDeviceId String       @map("gateway_device_id")
  slotIndex      Int           @map("slot_index")
  subscriptionId String?       @map("subscription_id")
  carrierName    String?       @map("carrier_name")
  phoneNumber    String        @map("phone_number")
  countryCode    String?       @map("country_code")
  isActive       Boolean       @default(true) @map("is_active")
  isDefault      Boolean       @default(false) @map("is_default")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  gateway GatewayDevice @relation(fields: [gatewayDeviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  smsJobs SmsJob[]
  smsAttempts SmsAttempt[]
  inboundSms InboundSms[]

  @@unique([gatewayDeviceId, slotIndex])
  @@map("gateway_sims")
}

model SmsJob {
  id               String       @id @default(uuid())
  externalId       String?      @unique @map("external_id")
  apiKeyId         String?      @map("api_key_id")
  userId           String?      @map("user_id")
  idempotencyKey   String?      @unique @map("idempotency_key")
  recipient        String
  message          String
  status           SmsJobStatus @default(QUEUED)
  priority         SmsPriority  @default(NORMAL)
  gatewayDeviceId  String?      @map("gateway_device_id")
  gatewaySimId     String?      @map("gateway_sim_id")
  attemptCount     Int          @default(0) @map("attempt_count")
  maxAttempts      Int          @default(3) @map("max_attempts")
  scheduledAt      DateTime?    @map("scheduled_at")
  claimedAt        DateTime?    @map("claimed_at")
  claimExpiresAt   DateTime?    @map("claim_expires_at")
  sentAt           DateTime?    @map("sent_at")
  deliveredAt      DateTime?    @map("delivered_at")
  failedAt         DateTime?    @map("failed_at")
  providerReference String?     @map("provider_reference")
  lastErrorCode    String?      @map("last_error_code")
  lastErrorMessage String?      @map("last_error_message")
  segmentCount     Int          @default(1) @map("segment_count")
  encoding         String       @default("GSM-7")
  metadata         Json?        @map("metadata")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  apiKey  ApiKey?        @relation(fields: [apiKeyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  gateway GatewayDevice? @relation(fields: [gatewayDeviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sim     GatewaySim?    @relation(fields: [gatewaySimId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attempts SmsAttempt[]
  webhookDeliveries WebhookDelivery[]

  @@index([status, scheduledAt], name: "sms_jobs_status_scheduled_at_idx")
  @@index([gatewayDeviceId, status], name: "sms_jobs_gateway_device_id_status_idx")
  @@index([recipient], name: "sms_jobs_recipient_idx")
  @@index([createdAt], name: "sms_jobs_created_at_idx")
  @@index([userId], name: "sms_jobs_user_id_idx")
  @@map("sms_jobs")
}

model InboundSms {
  id              String    @id @default(uuid())
  gatewayDeviceId String    @map("gateway_device_id")
  gatewaySimId    String?   @map("gateway_sim_id")
  clientMessageId String?   @unique @map("client_message_id")
  sender          String
  message         String
  receivedAt      DateTime  @map("received_at")
  simSlot         Int?      @map("sim_slot")
  subscriptionId  String?   @map("subscription_id")
  readAt          DateTime? @map("read_at")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")

  gateway GatewayDevice @relation(fields: [gatewayDeviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sim     GatewaySim?   @relation(fields: [gatewaySimId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([gatewayDeviceId, receivedAt], name: "inbound_sms_gateway_received_idx")
  @@index([receivedAt], name: "inbound_sms_received_at_idx")
  @@index([sender], name: "inbound_sms_sender_idx")
  @@map("inbound_sms")
}

model SmsAttempt {
  id              String        @id @default(uuid())
  smsJobId        String        @map("sms_job_id")
  gatewayDeviceId String        @map("gateway_device_id")
  gatewaySimId    String?       @map("gateway_sim_id")
  attemptNumber   Int           @map("attempt_number")
  status          String
  errorCode       String?       @map("error_code")
  errorMessage    String?       @map("error_message")
  startedAt       DateTime      @default(now()) @map("started_at")
  sentAt          DateTime?     @map("sent_at")
  completedAt     DateTime?     @map("completed_at")

  job     SmsJob         @relation(fields: [smsJobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gateway GatewayDevice  @relation(fields: [gatewayDeviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sim     GatewaySim?    @relation(fields: [gatewaySimId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("sms_attempts")
}

model WebhookEndpoint {
  id              String   @id @default(uuid())
  gatewayDeviceId String?  @map("gateway_device_id")
  url             String
  secret          String
  events          String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  gateway    GatewayDevice?    @relation(fields: [gatewayDeviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                String                @id @default(uuid())
  webhookEndpointId String                @map("webhook_endpoint_id")
  smsJobId          String?               @map("sms_job_id")
  event             String
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  statusCode        Int?                  @map("status_code")
  response          String?
  attemptCount      Int                   @default(0) @map("attempt_count")
  maxAttempts       Int                   @default(5) @map("max_attempts")
  nextRetryAt       DateTime?             @map("next_retry_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  smsJob   SmsJob?         @relation(fields: [smsJobId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("webhook_deliveries")
}

model OtpSession {
  id         String    @id @default(uuid())
  phone      String    @map("phone")
  purpose    String
  codeHash   String    @map("code_hash")
  status     String    @default("PENDING")
  attempts   Int       @default(0) @map("attempts")
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?    @map("verified_by")
  userId     String?   @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([phone, purpose, status])
  @@index([expiresAt])
  @@index([userId])
  @@map("otp_sessions")
}

model SuppressionList {
  id        String   @id @default(uuid())
  phone     String
  sender    String?
  purpose   String?
  reason    String?
  expiresAt DateTime?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("suppression_lists")
}

model SenderIdentity {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sender_identities")
}

model Template {
  id        String   @id @default(uuid())
  name      String   @unique
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

model DeadLetterJob {
  id        String   @id @default(uuid())
  smsJobId  String
  jobId     String?
  reason    String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dead_letter_jobs")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorType    String   @map("actor_type")
  actorId      String?  @map("actor_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  ip           String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt], name: "audit_logs_created_at_idx")
  @@map("audit_logs")
}